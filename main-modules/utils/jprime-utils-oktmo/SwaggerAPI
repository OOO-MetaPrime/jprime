openapi: 3.0.0
info:
  title: UniUtils REST API
  description: This is a Utils REST API
  contact:
    email: info@metaprime.ru
  license:
    name: Apache 2.0
    url: https://github.com/OOO-MetaPrime/jprime/blob/master/LICENSE
  version: 1.0.0
tags:
- name: action
  description: Запуск утилиты

paths:
  /utils/v1/oktmo-search/mode/get:
    post:
      tags:
      - action
      description: Получение данных по ОКТМО
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/get-request'
        required: true
      responses:
        200:
          description: OK
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/get-response'
        400:
          description: Bad request. See the logs for details
        401:
          description: Authorization information is missing or invalid.
        5XX:
          description: Unexpected error.

  /utils/v1/oktmo-search/mode/search:
    post:
      tags:
      - action
      description: Поиск ОКТМО
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/search-request'
        required: true
      responses:
        200:
          description: OK
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/search-response'
        400:
          description: Bad request. See the logs for details
        401:
          description: Authorization information is missing or invalid.
        5XX:
          description: Unexpected error.

  /utils/v1/oktmo-search/mode/getGroup:
    post:
      tags:
      - action
      description: Получение данных по группе ОКТМО
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/getGroup-request'
        required: true
      responses:
        200:
          description: OK
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/group-response'
        400:
          description: Bad request. See the logs for details
        401:
          description: Authorization information is missing or invalid.
        5XX:
          description: Unexpected error.

  /utils/v1/oktmo-search/mode/groupSearch:
    post:
      tags:
      - action
      description: Поиск групп ОКТМО
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/groupSearch-request'
        required: true
      responses:
        200:
          description: OK
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/group-response'
        400:
          description: Bad request. See the logs for details
        401:
          description: Authorization information is missing or invalid.
        5XX:
          description: Unexpected error.

components:
  schemas:
    get-request:
      type: object
      description: запуск утилиты
      properties:
        oktmo:
          type: array
          description: Список ОКТМО
          items:
            type: string
            example: ["38630000"]

    get-response:
      type: object
      description: ответ утилиты
      properties:
        oktmo:
          additionalProperties:
            type: array
            items:
              type: string
          example: {"38630000": "Поныровский муниципальный район"}

    search-request:
      type: object
      description: запуск утилиты
      properties:
        query:
          type: string
          description: поисковая строка
          example: ["25 смоленск"]
        limit:
          type: integer
          description: количество объектов в выборке
          example: 50
        subjectSearch:
          type: boolean
          description: поиск по субъектам
          example: true
        formationSearch:
          type: boolean
          description: поиск по муниципальному уровню
          example: true
        districtSearch:
          type: boolean
          description: поиск по поселенческому уровню
          example: true
        oktmoSearch:
          type: array
          items:
            type: string
          description: поиск с учетом указанных ОКТМО
          example: ["07000000"]
        authSearch:
          type: boolean
          description: поиск с учетом ОКТМО пользователя
          example: true

    search-response:
      type: object
      description: ответ утилиты
      properties:
        oktmo:
          additionalProperties:
            type: array
            items:
              type: string
          example: {"25612422": "Смоленское"}

    getGroup-request:
      type: object
      description: запуск утилиты
      properties:
        group:
          type: array
          description: Список групп ОКТМО
          items:
            type: string
            example: ["spbVyborgskiy"]
        prefixMode:
          type: boolean
          description: Возвращаем значимые префиксы ОКТМО, входящие в группу
          example: true

    groupSearch-request:
      type: object
      description: запуск утилиты
      properties:
        query:
          type: string
          description: поисковая строка
          example: ["выборгский"]
        limit:
          type: integer
          description: количество объектов в выборке
          example: 50
        prefixMode:
          type: boolean
          description: Возвращаем значимые префиксы ОКТМО, входящие в группу
          example: true
        oktmoSearch:
          type: array
          items:
            type: string
          description: поиск с учетом указанных ОКТМО
          example: ["07000000"]
        authSearch:
          type: boolean
          description: поиск с учетом ОКТМО пользователя
          example: true

    group-response:
      type: object
      description: ответ утилиты
      properties:
        groups:
          additionalProperties:
            type: array
            items:
              type: string
          example: {"spbVyborgskiy": {
                    "code": "spbVyborgskiy",
                    "name": "Выборгский район",
                    "oktmo": [
                      "40312",
                      "40313",
                      "40314",
                      "40315",
                      "40316",
                      "40317",
                      "40318",
                      "40319"
                    ]
                  }}

